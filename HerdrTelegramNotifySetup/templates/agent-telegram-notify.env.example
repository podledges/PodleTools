# Copy only to the Herdr-managed plugin config directory after installation.
# Enter values locally; never commit the resulting .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stay disabled until a human explicitly enables notifications.
HERDR_TELEGRAM_ENABLED=0

# Avoid changing terminal titles unless deliberately enabled later.
HERDR_TELEGRAM_SET_TITLE=0
HERDR_TELEGRAM_TITLE=TG on
