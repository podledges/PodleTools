+ * Remove the legacy plain-title attention marker without treating an
+ * intentional marker-only subject as empty. The old workaround prepended one
+ * or more `● ` tokens; renderer-owned indicators now carry the decoration.
+ */
+export function normalizeLegacyTitleMarker(value: string): string {
+	const normalized = value.replace(/^\s*(?:●\s+)+/, "");
+	return normalized.trim().length > 0 ? normalized : value;
