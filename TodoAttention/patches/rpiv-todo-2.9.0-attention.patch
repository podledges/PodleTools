+export type AttentionClass = "waiting" | "agent-working" | "captain-input";
+
+/** Neon blue chosen for active work on neon-afterglow's #06040f background. */
+export const ACTIVE_BLUE_RGB = [0, 102, 255] as const;
+export const ACTIVE_BLUE_HEX = "#0066FF";
+export const WAITING_YELLOW_RGB = [255, 255, 0] as const;
+export const WAITING_YELLOW_HEX = "#FFFF00";
+
+/**
+ * Classify only outstanding tasks. Captain input is explicit and wins. Active
+ * blue requires both in_progress and an explicit agent-working assertion; a
+ * pending, blocked, stale, or unknown task remains yellow.
+ */
+export function classifyAttention(task: Task): AttentionClass | undefined {
+	if (task.status === "completed" || task.status === "deleted") return undefined;
+	if (task.metadata?.attention === "captain-input") return "captain-input";
+	if (
+		task.status === "in_progress" &&
+		task.metadata?.attention === "agent-working" &&
+		(task.blockedBy?.length ?? 0) === 0
+	) {
+		return "agent-working";
+	}
+	return "waiting";
+}
+
+function truecolor(rgb: readonly [number, number, number], text: string): string {
+	return `\u001b[38;2;${rgb.join(";")}m${text}\u001b[39m`;
+}
+
+/** The one renderer-owned attention glyph, styled from structured task data. */
+export function formatAttentionIndicator(task: Task, theme: Theme): string {
+	switch (classifyAttention(task)) {
+		case "captain-input":
+			return theme.fg("accent", "●");
+		case "agent-working":
+			return truecolor(ACTIVE_BLUE_RGB, "●");
+		case "waiting":
+			return truecolor(WAITING_YELLOW_RGB, "●");
+		case undefined:
+			return "";
+	}
+}
+
+function formatTaskIdWithAttention(task: Task, theme: Theme): string {
+	const id = theme.fg("dim", `#${task.id}`);
+	const indicator = formatAttentionIndicator(task, theme);
+	return indicator ? `${id} ${indicator}` : id;
+}
